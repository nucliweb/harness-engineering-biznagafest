{
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Edit",
      "Write",
      "Agent",
      "Bash(pnpm lint*)",
      "Bash(pnpm typecheck*)",
      "Bash(pnpm test*)",
      "Bash(pnpm build*)",
      "Bash(pnpm --filter *)",
      "Bash(pnpm exec vitest *)",
      "Bash(node .claude/scripts/*)",
      "Bash(node --test*)",
      "Bash(git diff*)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git ls-files*)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(grep *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(npx playwright *)"
    ],
    "deny": ["Bash(git push*)", "Bash(git commit*)", "Bash(rm -rf *)", "Bash(rtk proxy *)"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post-edit-eslint.sh"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "explorer|plan-auditor|developer-package|reviewer-package|validator-global|design-qa",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/journal-capture.mjs"
          }
        ]
      }
    ]
  }
}
