{
  "name": "harness-engineering-biznagafest",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @agenda/app dev",
    "build": "pnpm --filter @agenda/app build",
    "lint": "eslint .",
    "lint:file": "eslint",
    "typecheck": "pnpm -r --workspace-concurrency=1 typecheck",
    "test": "vitest run && node --test \".claude/**/*.test.mjs\" \"scripts/**/*.test.mjs\"",
    "test:scripts": "node --test \".claude/**/*.test.mjs\" \"scripts/**/*.test.mjs\""
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "jsdom": "^30.1.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
